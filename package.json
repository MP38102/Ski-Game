{
  "name": "yeti-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Yeti Rush \u2013 ein Ski-Arcade-Spiel f\u00fcr iPad. Spiel, Website und Branding.",
  "type": "module",
  "scripts": {
    "brand": "node tools/build-brand.mjs",
