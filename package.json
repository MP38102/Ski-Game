{
  "name": "yeti-rush",
  "version": "1.0.0",
  "private": true,
  "description": "Yeti Rush – ein Ski-Arcade-Spiel für iPad. Spiel, Website und Branding.",
  "type": "module",
  "scripts": {
    "brand": "node tools/build-brand.mjs",
    "render": "node tools/render-assets.mjs",
    "sync": "node tools/sync.mjs",
    "build": "npm run brand && npm run render && npm run sync",
    "serve": "npx http-server . -p 8080 -c-1",
    "gipfelsturm:assets": "node gipfelsturm/tools/build-assets.mjs",
    "avalanche:build": "node avalanche-rider/tools/build.mjs",
    "avalanche:assets": "node avalanche-rider/tools/store-assets.mjs",
    "avalanche:test": "node avalanche-rider/tools/test.mjs"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.0.0",
    "opentype.js": "^1.3.4",
    "playwright": "^1.56.1"
  }
}
